# PageIntel AI - Environment Configuration Example
# Copy this file to .env and fill in your API keys

# Groq LLM Configuration (Get a free API key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face Remote Embeddings (Optional, free inference works without token)
HF_TOKEN=hf_your_huggingface_token_here
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tavily Live Search API (Optional, get key at https://tavily.com)
tavily_api_key=tvly-your_tavily_api_key_here

# Redis Connection (Defaults to localhost:6379 locally or redis://redis:6379 in Docker)
REDIS_URL=redis://localhost:6379

# Inactive Page TTL in Redis (default 300 seconds = 5 minutes)
PAGE_EXPIRATION_SECONDS=300

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=PageIntel AI
